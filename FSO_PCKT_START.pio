; PIO FSO Transceiver
; 4 cycles per bit - backward compatible with original firmware at low frequencies.
; Max speed: 31.25 MHz at 125 MHz SysClock (divider = 1.0)
;
; Cycle budget per bit (TX and RX must agree):
;   Cycle 1: output / NOP
;   Cycle 2: output / SAMPLE  <-- RX samples here (midpoint of bit)
;   Cycle 3: NOP
;   Cycle 4: JMP (TX loop overhead) / NOP
;
; TX Start bit:  4 cycles HIGH  (set pins, 1 [3])
; TX Data bit:   4 cycles total (out pins, 1 [2] + jmp [1])
; TX Idle:       4 cycles LOW   (set pins, 0 [3])
;
; RX waits for idle LOW, then rising edge of Start bit.
; After the Start bit the wrap loop samples every 4 cycles, hitting cycle 2.

; ---------------------------------------------------------------------------
; Transmitter
; ---------------------------------------------------------------------------
.program fso_tx
    pull block          ; Pull total packet bit count - 1 from FIFO
    out y, 32           ; Move count to Y scratch register
    set pins, 1 [3]     ; Start bit: drive HIGH for 4 cycles
bitloop:
    out pins, 1 [2]     ; Data bit: output for cycles 1-3
    jmp y--, bitloop    ; Cycle 4: decrement & loop
    set pins, 0 [3]     ; Return to idle LOW for 4 cycles

% c-sdk {
static inline void fso_tx_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_set_pins_with_mask(pio, sm, 0, 1u << pin);  // Idle LOW
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    pio_sm_config c = fso_tx_program_get_default_config(offset);
    sm_config_set_out_pins(&c, pin, 1);
    sm_config_set_set_pins(&c, pin, 1);
    sm_config_set_out_shift(&c, false, true, 32);  // MSB first, autopull at 32
    pio_sm_init(pio, sm, offset, &c);
}
%}

; ---------------------------------------------------------------------------
; Receiver
; ---------------------------------------------------------------------------
; Strategy: wait for idle, then align to the rising edge of the Start bit.
; After the 4-cycle Start bit we enter the wrap loop.
; The wrap loop is exactly 4 cycles and samples at cycle 2 (dead center).
;
; Alignment after Start bit edge (cycle 1 = edge detected):
;   wait 1 pin 0   -> cycle 1  (edge)
;   nop [1]        -> cycles 2, 3  (skip middle + end of Start bit)
;   nop            -> cycle 4
; Now we enter the wrap loop exactly at cycle 1 of bit 0.
;
; Wrap loop (4 cycles per bit):
;   nop            -> cycle 1  (setup)
;   in  pins, 1    -> cycle 2  (SAMPLE - center of bit)
;   nop [1]        -> cycles 3, 4
; Autopush fires every 8 bits.

.program fso_rx
public start:
    wait 0 pin 0        ; Wait for line idle LOW (handles mid-stream reset)
    wait 1 pin 0        ; Detect Start bit rising edge (= cycle 1 of Start bit)
    nop [2]             ; Cycles 2, 3, 4 of Start bit - burn remaining time
.wrap_target
    nop                 ; Cycle 1 of data bit
    in pins, 1          ; Cycle 2 of data bit - sample at center
    nop [1]             ; Cycles 3, 4 of data bit - autopush every 8 bits
.wrap

% c-sdk {
static inline void fso_rx_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, false);  // Input

    pio_sm_config c = fso_rx_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin);
    sm_config_set_in_shift(&c, false, true, 8);  // MSB first, autopush every 8 bits
    pio_sm_init(pio, sm, offset, &c);
}
%}
